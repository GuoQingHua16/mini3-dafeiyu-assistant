 /* ==================== 内部工具：异步播放队列 ==================== */
 
+#ifdef CONFIG_MINI3_LOCAL_AGENT
+/* Only the play worker owns this allocation. A failed/cancelled download never
+ * reaches the decoder. Require a bounded Content-Length, as sent by agent.py. */
+static bool local_audio_download(const tts_play_request_t *request)
+{
+    HTTPParameters *http = psram_calloc(1, sizeof(*http));
+    HTTP_CLIENT info = {0};
+    uint32_t received = 0;
+    bool opened = false, complete = false;
+    TickType_t started = xTaskGetTickCount();
+    if (!http) return false;
+    if (strlen(request->url) >= sizeof(http->Uri)) goto done;
+    strcpy(http->Uri, request->url);
+    http->HttpVerb = VerbGet;
+    http->nTimeout = 5; /* HTTP client uses seconds, unlike lisa_http request. */
+    opened = HTTPC_open(http) == 0;
+    if (!opened || !voice_player_tts_generation_is_current(request->generation) ||
+        HTTPC_request(http, NULL) != 0 ||
+        HTTPC_get_request_info(http, &info) != 0 || info.HTTPStatusCode != 200 ||
+        info.TotalResponseBodyLength == 0 ||
+        info.TotalResponseBodyLength > LOCAL_MP3_MAX_BYTES) goto done;
+    s_local_buffer = psram_malloc(info.TotalResponseBodyLength);
+    if (!s_local_buffer) goto done;
+    while (received < info.TotalResponseBodyLength) {
+        UINT32 count = 0;
+        uint32_t capacity = info.TotalResponseBodyLength - received;
+        if (capacity > 4096U) capacity = 4096U;
+        if (!voice_player_tts_generation_is_current(request->generation) ||
+            xTaskGetTickCount() - started >= pdMS_TO_TICKS(LOCAL_DOWNLOAD_TIMEOUT_MS)) goto done;
+        int rc = HTTPC_read(http, s_local_buffer + received, capacity, &count);
+        if (count > capacity || count == 0 ||
+            (rc != 0 && rc != HTTP_CLIENT_EOS)) goto done;
+        received += count;
+        if (rc == HTTP_CLIENT_EOS && received != info.TotalResponseBodyLength) goto done;
+    }
+    complete = voice_player_tts_generation_is_current(request->generation) &&
+        xTaskGetTickCount() - started < pdMS_TO_TICKS(LOCAL_DOWNLOAD_TIMEOUT_MS) &&
+        local_mp3_has_complete_frames(s_local_buffer, received);
+done:
+    if (opened) HTTPC_close(http);
+    psram_free(http);
+    taskENTER_CRITICAL();
+    s_local_bytes = received;
+    s_local_download_ms = (xTaskGetTickCount() - started) * portTICK_PERIOD_MS;
+    taskEXIT_CRITICAL();
+    LOGI("local audio download complete=%u bytes=%u time=%ums", complete,
+         (unsigned)received, (unsigned)s_local_download_ms);
+    return complete;
+}
+
+static void voice_player_tts_play_local(const tts_play_request_t *request)
+{
+    voice_tts_owned_result_t result = VOICE_TTS_OWNED_FAILED;
+    bool decoder_used = false, safe_to_free = true;
+    taskENTER_CRITICAL();
+    s_local_buffer_busy = true;
+    s_local_event_done = false;
+    s_local_event_result = VOICE_TTS_OWNED_PENDING;
+    s_local_bytes = s_local_download_ms = 0;
+    taskEXIT_CRITICAL();
+    if (!local_audio_download(request)) goto done;
+    if (!voice_player_tts_generation_is_current(request->generation)) goto done;
+    char url[80];
+    /* SDK mem_audio sample's mem:// syntax, with a PSRAM address instead of
+     * Flash. Keep the allocation alive until stop/reset closes the reader. */
+    snprintf(url, sizeof(url), "mem://addr=%usize=%u",
+             (unsigned)(uintptr_t)s_local_buffer, (unsigned)s_local_bytes);
+    app_player_play_opt_t options = {
+        .url = url, .request_tag = request->generation,
+        /* Do not abandon a PREPARED memory reader on cancellation. Let play_ex
+         * settle, then stop synchronously below, before freeing its source. */
+        .cancel_token = NULL,
+    };
+    taskENTER_CRITICAL();
+    s_playing_generation = request->generation;
+    taskEXIT_CRITICAL();
+    decoder_used = true;
+    if (app_player_play_ex(tts_player, &options) == APP_PLAYER_OK) {
+        TickType_t started = xTaskGetTickCount();
+        while (voice_player_tts_generation_is_current(request->generation)) {
+            taskENTER_CRITICAL();
+            bool finished = s_local_event_done;
+            result = s_local_event_result;
+            taskEXIT_CRITICAL();
+            if (finished) break;
+            if (xTaskGetTickCount() - started >= pdMS_TO_TICKS(90000)) {
+                result = VOICE_TTS_OWNED_FAILED;
+                break;
+            }
+            vTaskDelay(pdMS_TO_TICKS(20));
+        }
+    }
+done:
+    if (!voice_player_tts_generation_is_current(request->generation))
+        result = VOICE_TTS_OWNED_INTERRUPTED;
+    if (decoder_used) {
+        app_player_state_t state = app_player_get_state(tts_player);
+        if (state != APP_PLAYER_STATE_IDLE && state != APP_PLAYER_STATE_STOPPED)
+            (void)app_player_stop(tts_player);
+        state = app_player_get_state(tts_player);
+        safe_to_free = (state == APP_PLAYER_STATE_IDLE || state == APP_PLAYER_STATE_STOPPED) &&
+                       app_player_reset(tts_player) == APP_PLAYER_OK;
+    }
+    if (safe_to_free) {
+        psram_free(s_local_buffer);
+        s_local_buffer = NULL;
+    } else {
+        /* Fail closed: do not free a buffer that an unsettled decoder may
+         * still read, and do not let another request overwrite its pointer. */
+        result = VOICE_TTS_OWNED_FAILED;
+        LOGE("local audio reader did not close; buffer retained until reboot");
+    }
+    taskENTER_CRITICAL();
+    if (s_owned_generation == request->generation &&
+        s_owned_result == VOICE_TTS_OWNED_PENDING) {
+        s_owned_result = result == VOICE_TTS_OWNED_PENDING ? VOICE_TTS_OWNED_FAILED : result;
+        s_tts_active = false;
+    }
+    if (s_owned_stop_generation == request->generation) s_owned_stop_generation = 0;
+    s_local_buffer_busy = !safe_to_free;
+    taskEXIT_CRITICAL();
+    LOGI("local audio finished result=%u released=%u", (unsigned)result, safe_to_free);
+}
+
